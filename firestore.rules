rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.uid == '6Djehd9KB8dTZUgVwVJfLoPI5dF3';
    }

    function isOwnDoc(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 'isPro' was written by the client and read by nothing. It stays on the
    // list so it can never become a self-service premium flag if some view
    // starts honouring it later.
    // 'subscriptionPlan' and 'availableTrialMinutes' gate paid access, so like
    // the premium flags they must only ever be written by an admin or a Cloud
    // Function (admin SDK) — never self-served from the client.
    // The cohort/cycle fields below decide trial-vs-course access and course
    // progress. They are set once by the redeemCode / claimCourseCompletion
    // Cloud Functions (admin SDK); a client must never mutate them — otherwise a
    // modified client could self-promote to 'course', reset trialStartedAt to
    // dodge the 2-day gate, or forge course completion. trialStartedAt is
    // created (not updated) at registration, so it is on the update-guard list
    // but NOT the create-guard list.
    // cohortStatus burada MÜTLƏQDİR: client onu öz sənədinə yaza bilsəydi,
    // 'pending' trial gate-i keçər, 'accepted' isə adminin "Başlat"ında
    // təsdiqsiz kurs+premium verərdi. Yalnız server (redeemCode/startCohort,
    // Admin SDK) və admin paneli yaza bilər.
    // Müəllim sahələri: teacherId/completedSessions və s. yalnız server
    // (consumeTrialMinutes / claimTeacherCode / createInviteCode, Admin SDK)
    // tərəfindən yazılır. `role` və `teacherEligible` isə B2B2C onboarding-də
    // qeydiyyatda AÇIQ seçilir — ona görə client onları yalnız BİR DƏFƏ
    // (sahə hələ yoxdursa) və yalnız icazəli dəyərlərlə qoya bilər; sonradan
    // dəyişmək yenə qadağandır (rol dəyişmək = server/admin işi).
    // teacherVerified/tutorProfile/tutorStudentCount/tutorMinutesCoached isə
    // MÜTLƏQ server-onlydır: `role` qeydiyyatda açıq seçildiyi üçün nişanı ona
    // bağlamaq olmaz — nişanın yeganə şərti teacherVerified-dir və o, yalnız
    // adminin setTutorVerification funksiyasından gəlir. Sayğaclar da publik
    // profildə göstərilir, yəni client onları yazsaydı statistika uydurula bilərdi.
    // practiceSlotIds/recurringSlots/upcomingCall/missedSlots də server-onlydır:
    // randevunu və tələb sayğaclarını client yazsaydı, lövhədəki "2 nəfər
    // gözləyir" uydurula bilərdi. `slotNoticePending` isə QƏSDƏN siyahıda
    // DEYİL — nəzakətli xatırlatmanı bağlamaq üçün client onu silməlidir və ən
    // pis halda istifadəçi öz xatırlatmasını gizlədir (təhlükəsizlik təsiri yox).
    function validRoleOneTimeSet() {
      return (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
          || (!('role' in resource.data) && request.resource.data.role in ['student', 'teacher']))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['teacherEligible'])
          || (!('teacherEligible' in resource.data)
            && request.resource.data.teacherEligible == true
            && request.resource.data.role == 'teacher'));
    }

    function isNotChangingPremiumFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['isPremium', 'premiumSince', 'premiumPlan', 'isPro', 'subscriptionPlan', 'availableTrialMinutes',
          'mode', 'startTick', 'cohortId', 'cohortStatus', 'cohortAppliedAt',
          'trialStartedAt', 'courseActivatedAt', 'courseCompletedAt', 'freeAccessUntil',
          'teacherId', 'teacherLinkedAt', 'teacherConsentAt', 'ageConfirmedAt',
          'isAdult', 'completedSessions',
          'teacherVerified', 'tutorProfile', 'tutorStudentCount', 'tutorMinutesCoached',
          'practiceSlotIds', 'recurringSlots', 'upcomingCall', 'missedSlots'])
        && validRoleOneTimeSet();
    }

    function isNotCreatingPremiumFields() {
      return !request.resource.data.keys().hasAny(['isPremium', 'premiumSince', 'premiumPlan', 'isPro', 'subscriptionPlan', 'availableTrialMinutes',
          'startTick', 'cohortId', 'cohortStatus', 'cohortAppliedAt', 'courseActivatedAt', 'courseCompletedAt', 'freeAccessUntil',
          'teacherId', 'teacherLinkedAt', 'teacherConsentAt', 'ageConfirmedAt',
          'isAdult', 'completedSessions',
          'teacherVerified', 'tutorProfile', 'tutorStudentCount', 'tutorMinutesCoached',
          'practiceSlotIds', 'recurringSlots', 'upcomingCall', 'missedSlots'])
        // A newly created doc may only self-declare the trial mode, never course.
        && (!request.resource.data.keys().hasAny(['mode']) || request.resource.data.mode == 'trial')
        // Rol yaradılışda seçilə bilər; teacherEligible yalnız teacher rolu ilə birgə.
        && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role in ['student', 'teacher'])
        && (!request.resource.data.keys().hasAny(['teacherEligible'])
          || (request.resource.data.teacherEligible == true && request.resource.data.role == 'teacher'));
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwnDoc(userId) && isNotCreatingPremiumFields();
      allow update: if isAdmin() || (isOwnDoc(userId) && isNotChangingPremiumFields());
      allow delete: if isAdmin();

      // Per-device FCM push tokens. Each device writes its own doc (id = hash of
      // the token) so devices don't overwrite each other. Only the owner
      // manages them; Cloud Functions read/prune via the Admin SDK.
      match /fcmTokens/{tokenId} {
        allow read, write: if isOwnDoc(userId);
      }

      // Blok siyahısı (Play UGC tələbi): sənədin mövcudluğu = blok. Yalnız
      // sahibi görür/idarə edir; sendCallNotification Admin SDK ilə oxuyur.
      match /blocked/{peerId} {
        allow read, write: if isOwnDoc(userId);
      }

      // Şəxsi məlumat (hazırda: yaş təsdiqi + valideyn razılığı). users/{uid}
      // sənədini hər daxil olmuş istifadəçi oxuya bilir (yuxarıdakı read
      // qaydası), ona görə xam doğum tarixi orada YOX, burada saxlanılır.
      // Yalnız claimTeacherCode (Admin SDK) yazır.
      match /private/{docId} {
        allow read: if isOwnDoc(userId);
        allow write: if false;
      }
    }

    // İstifadəçi şikayətləri (Play UGC tələbi). Client yalnız ÖZ adından
    // yarada bilir; oxumaq/dəyişmək yalnız adminə açıqdır — şikayət olunan
    // şəxs şikayəti görə bilməz.
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.keys().hasOnly(['reporterId', 'reportedId', 'reportedName', 'reason', 'createdAt', 'status'])
        && request.resource.data.status == 'open'
        && request.resource.data.reportedId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500;
      allow read, update, delete: if isAdmin();
    }

    match /premiumRequests/{userId} {
      allow read: if isAdmin() || isOwnDoc(userId);
      allow create: if isAdmin() || (
        isOwnDoc(userId)
        && request.resource.data.uid == userId
        && request.resource.data.status == 'pending'
      );
      allow update: if isAdmin() || (
        isOwnDoc(userId)
        && resource.data.status == 'pending'
        && request.resource.data.uid == userId
        && request.resource.data.status == 'pending'
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['activatedAt', 'activatedBy'])
      );
      allow delete: if isAdmin();
    }

    // Çat sənədinin id-si sıralanmış uid cütüdür, ona görə üzvlük id-dən
    // çıxarılır (participants massivinə güvənmək olmaz — onu da client yazır).
    function isChatMember(chatId) {
      return isSignedIn() && (
        chatId.split("_")[0] == request.auth.uid ||
        chatId.split("_")[1] == request.auth.uid
      );
    }
    function chatPeer(chatId) {
      return chatId.split("_")[0] == request.auth.uid
        ? chatId.split("_")[1]
        : chatId.split("_")[0];
    }

    match /chats/{chatId} {
      // GET and LIST are split, and they have to be.
      //
      // `isChatMember` derives membership from the document ID, which is fine
      // for reading one known chat. It CANNOT authorise a query: rules are not
      // filters, so for a list Firestore has to prove from the query's own
      // constraints that every document it could return is allowed — and it has
      // no way to reason about `chatId.split("_")` before reading anything. The
      // whole subscription therefore failed with "Missing or insufficient
      // permissions", subscribeToChats fell into its error branch and reported
      // an empty list, and the Chats tab stayed empty for ever. You could still
      // open a conversation by URL (a get) and see every message, which is why
      // this read as "the chat only appears if the other person opens it".
      //
      // The list rule leans on `participants` instead, which the query filters
      // on, so it is provable. That array is client-written, but the only thing
      // a forged entry buys is having someone else's chat listed — the get,
      // update and message rules all still go through isChatMember, so nothing
      // can actually be read or written that way.
      allow get: if isChatMember(chatId);
      allow list: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if isChatMember(chatId);
      // Oxunmamış sayğac: hər kəs YALNIZ öz sayını sıfırlaya bilər. Qarşı
      // tərəfinki toxunulmazdır — əks halda mesaj göndərən adam qarşı tərəfin
      // "oxunmamış" nişanını silib bildirişi gizlədə bilərdi. Sayğacı artıran
      // yeganə yer serverdir (notifyChatMessage).
      allow update: if isChatMember(chatId)
        && request.resource.data.get('unread', {}).get(chatPeer(chatId), 0)
           == resource.data.get('unread', {}).get(chatPeer(chatId), 0);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId)
          && request.auth.uid == request.resource.data.senderId;
        // "Hamı üçün sil" = mətnin boşaldılması + deleted bayrağı. Yalnız bu iki
        // sahəyə icazə var: əks halda göndərən köhnə mesajın mətnini sonradan
        // tamamilə dəyişib söhbətin gedişini saxtalaşdıra bilərdi.
        allow update: if request.auth.uid == resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['deleted', 'text']);
        allow delete: if request.auth.uid == resource.data.senderId;
      }
    }

    match /calls/{callId} {
      // `resource != null` is not decoration, and it is why teacherInvites and
      // slotChanges below carry the same guard.
      //
      // Call documents get DELETED — on reject, and when a call is cleaned up.
      // Chat.jsx keeps a listener on the call doc for the whole call, so it is
      // still attached at the moment the document disappears. Firestore then
      // evaluates this rule with a null resource, `resource.data.callerId`
      // throws, and a rule that errors is reported to the client as
      // permission-denied. That is the "Uncaught Error in snapshot listener:
      // FirebaseError [code=permission-denied]" that appeared every time a
      // call ended — nothing was actually forbidden, the rule just could not
      // survive the document going away.
      allow read: if isSignedIn() && resource != null && (
        request.auth.uid == resource.data.callerId ||
        request.auth.uid == resource.data.receiverId ||
        request.auth.uid == resource.data.userA ||
        request.auth.uid == resource.data.userB
      );
      allow create: if request.auth.uid == request.resource.data.callerId || 
                       request.auth.uid == request.resource.data.userA || 
                       request.auth.uid == request.resource.data.userB;
      allow update: if request.auth.uid == resource.data.callerId || 
                       request.auth.uid == resource.data.receiverId ||
                       request.auth.uid == resource.data.userA || 
                       request.auth.uid == resource.data.userB;
      allow delete: if request.auth.uid == resource.data.callerId || 
                       request.auth.uid == resource.data.receiverId ||
                       request.auth.uid == resource.data.userA || 
                       request.auth.uid == resource.data.userB;
    }

    match /matchQueue/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwnDoc(userId);
      // A peer may only flip a *searching* ticket to matched-with-themselves,
      // and only those four fields. Previously any signed-in user could
      // rewrite anyone's whole ticket (callId included) at any time.
      allow update: if isOwnDoc(userId) || (
        isSignedIn()
        && resource.data.status == 'searching'
        && request.resource.data.status == 'matched'
        && request.resource.data.matchedWith == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'matchedWith', 'callId', 'matchedAt'])
      );
      allow delete: if isOwnDoc(userId);
    }

    match /appConfig/{docId} {
      // Session schedule + cycle state — clients read it, only the admin edits
      // it. The cycle doc is advanced by the advanceCycle Cloud Function.
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Cohorts hold the entry CODES, so normal clients must not read them (codes
    // would be enumerable). Redemption goes through the redeemCode Cloud
    // Function (admin SDK, bypasses rules); the admin panel reads them directly.
    // Exception: a MEMBER may read their own cohort doc (name/memberCount for
    // the welcome screen and the Home cohort card) — they already know its
    // code, and other cohorts' codes stay unreadable. `get` (not list), so the
    // collection can never be enumerated.
    match /cohorts/{cohortId} {
      allow get: if isAdmin() || (
        isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.cohortId == cohortId
      );
      allow list, write: if isAdmin();
    }

    match /waitlist/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 5
        && request.resource.data.email.size() < 200;
      allow read, update, delete: if isAdmin();
    }

    match /analysisQueue/{docId} {
      // Clients may only create their own pending ticket pointing at their
      // own recording; claiming/retrying/deleting is done by the scheduled
      // worker through the Admin SDK (bypasses rules).
      allow create: if isSignedIn()
        && docId.split('_')[0] == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'status', 'storagePath', 'audioSeconds', 'callSeconds', 'uid',
          'callDocId', 'sessionId', 'peerName', 'retryCount', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.retryCount == 0
        // audioSeconds = yüklənən faylın uzunluğu (sükut kəsildikdən sonra),
        // callSeconds = zəngin divar saatı müddəti. Sükut kəsmə səbəbindən
        // birincisi ikincidən kiçik ola bilər, amma böyük OLA BİLMƏZ.
        && request.resource.data.audioSeconds is number
        && request.resource.data.audioSeconds > 0
        && request.resource.data.audioSeconds <= 3600
        && request.resource.data.callSeconds is number
        && request.resource.data.callSeconds > 0
        && request.resource.data.callSeconds <= 3600
        && request.resource.data.audioSeconds <= request.resource.data.callSeconds
        && request.resource.data.callDocId is string
        && request.resource.data.sessionId is string
        // Uzantı .webm VƏ YA .mp4 ola bilər: iOS Safari webm dəstəkləmir və
        // MediaRecorder mp4 yazır. Yalnız .webm tələb edildiyi üçün həmin
        // istifadəçilərin ticket-i rədd olunurdu — analiz heç vaxt gəlmirdi.
        && (request.resource.data.storagePath ==
              'callRecordings/' + request.auth.uid + '/'
              + request.resource.data.callDocId + '_'
              + request.resource.data.sessionId + '.webm'
            || request.resource.data.storagePath ==
              'callRecordings/' + request.auth.uid + '/'
              + request.resource.data.callDocId + '_'
              + request.resource.data.sessionId + '.mp4');
      allow read: if isSignedIn() && docId.split('_')[0] == request.auth.uid;
      allow update, delete: if false;
    }

    match /callAnalysis/{docId} {
      // Müəllim funnel-inin ƏSAS dəyəri: bağlı şagirdin AI analizini müəllim
      // oxuya bilir. Şagird bunun razılığını claimTeacherCode-da açıq verib
      // (teacherConsentAt). get() sənəd-başına 1 əlavə oxu deməkdir — kiçik
      // roster üçün qəbul olunandır; şagird linki qırılsa (teacherId dəyişsə)
      // giriş özü-özünə bağlanır, heç nə purge etmək lazım deyil.
      allow read: if isSignedIn() && (
        docId.split('_')[0] == request.auth.uid ||
        (resource != null && resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId is string
          && get(/databases/$(database)/documents/users/$(resource.data.userId)).data.teacherId == request.auth.uid)
      );
      // Clients only seed the "queued" placeholder for their OWN recording.
      // The analysis itself is written by the worker through the Admin SDK.
      // The old rule OR'd the two clauses, so anyone could overwrite another
      // user's analysis simply by setting userId to their own uid.
      allow create: if isSignedIn()
        && docId.split('_')[0] == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'queued'
        && request.resource.data.keys().hasOnly(['status', 'userId', 'timestamp']);
      allow update, delete: if false;
    }

    // AInur activity sessions. The learner reads their own; nobody writes from
    // a client. Turns are appended server-side by aiActivityTurn because the
    // transcript is what the analysis -- and the teacher report -- is built
    // from. If the client could edit it, a learner could hand their teacher a
    // session they never spoke.
    match /aiSessions/{docId} {
      allow read: if isSignedIn() && docId.split('_')[0] == request.auth.uid;
      allow write: if false;
    }

    // NOTE: aiUsage has NO match block on purpose. It is the per-user daily AI
    // cost meter (STT seconds, TTS characters, tokens) and only the server
    // writes it, exactly like analysisBudget. The catch-all below denies it.

    match /wordHistory/{userId}/words/{wordId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Müəllim profili + şagird siyahısı. Yalnız müəllimin özü oxuyur; bütün
    // yazılar createInviteCode / claimTeacherCode (Admin SDK) üzərindəndir —
    // əks halda müəllim studentCap-ı və ya studentCount-u özü dəyişə bilərdi.
    match /teachers/{teacherId} {
      allow read: if isOwnDoc(teacherId);
      allow write: if false;

      match /roster/{studentId} {
        allow read: if isOwnDoc(teacherId);
        allow write: if false;
      }
    }

    // Birbaşa müəllim dəvətləri. Yalnız iki tərəf oxuya bilir; bütün yazılar
    // serverdən (inviteStudentByEmail / respondTeacherInvite, Admin SDK) —
    // əks halda şagird özünü istənilən müəllimə bağlaya, müəllim isə saxta
    // "qəbul edildi" yaza bilərdi.
    match /teacherInvites/{inviteId} {
      allow read: if isSignedIn() && resource != null && (
        resource.data.studentUid == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );
      allow write: if false;
    }

    // Praktika slotları. Valideyn sənəddə QƏSDƏN yalnız SAYLAR var (ad yoxdur):
    // lövhə "14:00-da 2 nəfər gözləyir" göstərir, kimin olduğunu yox. Qoşulma
    // düyməsi şəxsə yox, bloka basılır — deməli cherry-picking və rədd edilmə
    // mümkün deyil. Adlar members alt-kolleksiyasındadır və onları YALNIZ
    // sahibi oxuya bilir.
    //
    // Bütün yazılar server tərəfindədir (joinPracticeSlot / leavePracticeSlot /
    // practiceSlotTick): saylar client-yazılan olsaydı, lövhədəki tələb
    // uydurula bilərdi. Yeganə istisna `arrivedAt` — gözləmə otağına girişin
    // qeydi; o da matchQueue-dakı ilə eyni hasOnly pattern-i ilə kilidlənib və
    // ən pis halda nəzakətli xatırlatmaya təsir edir.
    match /practiceSlots/{slotId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /members/{memberId} {
        // Öz üzvlüyünü hər kəs oxuyur; admin isə slot nəzarəti üçün BÜTÜN
        // üzvləri oxuya bilir (kim hansı bloka yazılıb — Admin › Görüşlər).
        allow read: if isOwnDoc(memberId) || isAdmin();
        allow create, delete: if false;
        allow update: if isOwnDoc(memberId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['arrivedAt']);
      }
    }

    // Vaxt dəyişikliyi təklifi — teacherInvites ilə eyni pattern: iki tərəf
    // oxuyur, yazmaq YALNIZ serverdədir. Client yaza bilsəydi, qarşı tərəfin
    // razılığını saxtalaşdırıb randevunu təkbaşına köçürə bilərdi.
    match /slotChanges/{requestId} {
      allow read: if isSignedIn() && resource != null && (
        resource.data.proposerUid == request.auth.uid ||
        resource.data.peerUid == request.auth.uid
      );
      allow write: if false;
    }

    // DİQQƏT: slotRuns üçün də QƏSDƏN match bloku yoxdur — onlar yalnız
    // "bu push artıq göndərilib" markerləridir, client-in nə oxumağa, nə də
    // yazmağa ehtiyacı var. Client yaza bilsəydi, xatırlatmaları susdura bilərdi.

    // DİQQƏT: inviteCodes üçün QƏSDƏN match bloku yoxdur. Aşağıdakı catch-all
    // onu tam bağlayır və bu, tam olaraq istənilən davranışdır: kodu yoxlamaq
    // yalnız serverdə (claimTeacherCode) baş verir, oxumağı bağlamaq isə
    // kolleksiyanı sayıb işlək kod tapmağın (enumeration) qarşısını alır.
    // Buraya "rahatlıq üçün" read əlavə etmək bütün kodları ifşa edər.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
